# ==============================================================================
# University Application Manager - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and fill in your private information.
# The '.env' file is ignored by Git and will NOT be committed to public repos.
# ==============================================================================

# Application Environment (development, test, production)
APP_ENV=production
APP_DEBUG=false

# Custom Database Directory (Leave empty to use default: ~/Documents/UniversityApplications/)
# EXCEL_DATABASE_DIR=/path/to/your/preferred/folder
EXCEL_DATABASE_DIR=

# Default Applicant Information (Personal details for auto-fill)
DEFAULT_APPLICANT_NAME=Your Full Name
DEFAULT_APPLICANT_EMAIL=your.email@example.com
DEFAULT_APPLICANT_PHONE=+1234567890
DEFAULT_PASSPORT_NUMBER=

# Academic Scores & Credentials
DEFAULT_IELTS_SCORE=7.5
DEFAULT_GPA_SCORE=3.8
DEFAULT_GRADUATION_YEAR=2026

# External API Keys (Optional integrations)
EXCHANGE_RATE_API_KEY=
UNIVERSITY_DATA_API_KEY=
